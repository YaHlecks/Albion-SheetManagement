[TEMPLATE]
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Canonical origin embedded in verification / password-reset email links.
# Production: your deployed URL. Local dev can leave this unset
# (falls back to VERCEL_URL, then http://localhost:3000).
# Must be allowlisted in Supabase → Authentication → URL Configuration.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only. Admin operations (approval, member management, audit views).
# If unset, the app falls back to anon key + is_event_admin() RPC guards (works on self-hosted Supabase).
SUPABASE_SERVICE_ROLE_KEY=

# Postgres connection string for `npm run db:push`
DATABASE_URL=postgres://user:password@host:5432/postgres
