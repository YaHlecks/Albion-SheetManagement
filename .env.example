NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Admin operations (approval, team management, audit views).
# If unset, the app falls back to anon key + is_platform_admin() RPCs (works on self-hosted Supabase).
SUPABASE_SERVICE_ROLE_KEY=

# Postgres connection string for `npm run db:push`
DATABASE_URL=postgres://user:password@host:5432/postgres
